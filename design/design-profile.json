{
  "schemaVersion": 1,
  "profileId": "calm-study-blue",
  "profileName": "Calm Study Blue",
  "status": "proposed-default-awaiting-user-preferences",
  "principles": [
    "One shared visual language across every module",
    "Readable learning content before compact density",
    "Blue/navy as the primary learning/navigation color; green only for positive progress",
    "Cards, panels, controls and spacing use named shared tokens",
    "Responsive behavior follows CSS viewport width and content, never physical device inches",
    "Cards in the same grid row use equal outer height and a shared footer baseline",
    "Instructional images use one declared aspect ratio and crop policy per media role",
    "Long text wraps safely; content is not clipped to preserve equal card geometry"
  ],
  "cssVariables": {
    "--ds-font-family": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Noto Sans\", Arial, sans-serif",
